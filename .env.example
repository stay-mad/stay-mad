# Stay Mad — Local Environment Variables
# Copy file ini menjadi .env jika ingin mengkustomisasi nilai default:
#   cp .env.example .env

# --- Gemini API (Wajib untuk inferensi live LLM & embeddings) ---
# Dapatkan key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=staymad
POSTGRES_PASSWORD=staymad_secret
POSTGRES_DB=staymad_db
POSTGRES_PORT=5432

# --- Backend Application ---
ENVIRONMENT=development
DATA_MODE=live
GEMINI_FIXTURE_MODE=false
LOG_FORMAT=json
PORT=8080
HOST=0.0.0.0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=3000
